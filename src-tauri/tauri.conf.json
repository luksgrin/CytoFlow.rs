{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CytoFlow",
  "version": "0.1.0",
  "identifier": "rs.cytoflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CytoFlow",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "public.app-category.medical",
    "shortDescription": "Flow cytometry analysis",
    "longDescription": "CytoFlow.rs is an open-source flow cytometry analysis application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "publisher": "Lucas Goiriz",
    "copyright": "Copyright (c) Lucas Goiriz. MIT License.",
    "license": "MIT",
    "homepage": "https://luksgrin.xyz/CytoFlow.rs/",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "section": "science"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
